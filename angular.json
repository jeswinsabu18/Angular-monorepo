{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "apps",
  "projects": {
    "employee-management": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/employee-management",
      "sourceRoot": "apps/employee-management/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/employee-management/src/main.ts",
            "tsConfig": "apps/employee-management/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/employee-management/public"
              },
              {
                "glob": "**/*",
                "input": "apps/employee-management/src/assets",
                "output": "assets"
              }
            ],
            "styles": ["apps/employee-management/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.6MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "employee-management:build:production"
            },
            "development": {
              "buildTarget": "employee-management:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/employee-management/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
