{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "employee-management",
  "projectType": "application",
  "root": "apps/employee-management",
  "sourceRoot": "apps/employee-management/src",
  "prefix": "app",
  "tags": ["scope:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/employee-management"],
      "dependsOn": ["^build"],
      "defaultConfiguration": "production",
      "options": {
        "browser": "apps/employee-management/src/main.ts",
        "tsConfig": "apps/employee-management/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/employee-management/public"
          },
          {
            "glob": "**/*",
            "input": "apps/employee-management/src/assets",
            "output": "assets"
          }
        ],
        "styles": ["apps/employee-management/src/styles.css"]
      },
      "configurations": {
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.6MB",
              "maximumError": "2MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all"
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "defaultConfiguration": "development",
      "options": {
        "port": 4200
      },
      "configurations": {
        "development": {
          "buildTarget": "employee-management:build:development"
        },
        "production": {
          "buildTarget": "employee-management:build:production"
        }
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "nx build employee-management --watch --configuration=development"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/employee-management/tsconfig.spec.json"
      }
    }
  }
}
