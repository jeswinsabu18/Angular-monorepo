{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@employee-management/shared-ui": ["./packages/shared/shared-ui/src/index.ts"],
      "@employee-management/shared-models": ["./packages/shared/models/src/index.ts"],
      "@employee-management/employee-data": ["./packages/employee/data/src/index.ts"],
      "@employee-management/employee-feature-employees": [
        "./packages/employee/feature-employees/src/index.ts"
      ],
      "@employee-management/employee-feature-details": [
        "./packages/employee/feature-details/src/index.ts"
      ],
      "@employee-management/employee-feature-analytics": [
        "./packages/employee/feature-analytics/src/index.ts"
      ],
      "@employee-management/auth-data": ["./packages/auth/data/src/index.ts"],
      "@employee-management/auth-feature-auth": ["./packages/auth/feature-auth/src/index.ts"],
      "@employee-management/access-management-feature": [
        "./packages/access-management/feature/src/index.ts"
      ],
      "@employee-management/settings-data-theme": ["./packages/settings/data-theme/src/index.ts"],
      "@employee-management/settings-feature-help": [
        "./packages/settings/feature-help/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  }
}
